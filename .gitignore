# Python caches and environments
__pycache__/
*.py[cod]
.venv/
.venv-release/

# Test, coverage, and static-analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Packaging outputs
build/
dist/
*.egg-info/

# Generated datasets and local experiments
data/
generated/
experiments/
reproduced-*/
*.tmp

# Run artifacts. The evidence JSONs in results/ are tracked deliberately --
# every measured claim in the README cites one -- but scratch run logs and
# rendered debug dumps are regenerable and would bloat the repository.
results/*.log
results/*.npz
results/*.joblib
results/phase2_failures/
results/phase2_report/
results/sponsor_baseline/

# Regenerable explainer screenshot cache (rebuild with render_explainer_video.py)
docs/demo/slides/

# Rendered explainer media. 42 MB of MP4 and WAV that render_explainer_video.py
# and build_narrated_video.py rebuild from the tracked slides and script, so the
# blobs do not belong in history. The 0.6 MB terminal demo stays: the submission
# zip ships it.
docs/demo/latticerank_explainer.mp4
docs/demo/latticerank_explainer_narrated.mp4
docs/demo/explainer_narration_timed.wav

# Local editor state
.idea/
.vscode/
